{
    "name": "ampa/portal-cliente",
    "description": "Cliente del portal del AMPA: la sesión de la suite y los permisos, para las aplicaciones Symfony.",
    "type": "symfony-bundle",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-client": "^7.4",
        "symfony/security-bundle": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "symfony/browser-kit": "^7.4",
        "symfony/yaml": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Ampa\\PortalCliente\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ampa\\PortalCliente\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
