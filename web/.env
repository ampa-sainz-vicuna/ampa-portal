# Configuración del frontend del portal. Todo lo que empieza por VITE_ acaba
# DENTRO del JavaScript que se descarga el navegador: aquí no puede ir nada
# secreto.

# ID de cliente OAuth de Google. Es público por diseño (el navegador lo
# necesita para pintar el botón); el mismo valor que GOOGLE_CLIENT_ID en
# api/.env. Hay que tener dado de alta el origen del portal en ese cliente
# (http://localhost:5176 en desarrollo).
VITE_GOOGLE_CLIENT_ID=273203000301-6psq29vv6e3e607hpoqhhvq6be49pvgf.apps.googleusercontent.com

# Solo es una pista para que Google ofrezca cuentas del AMPA. Quien de verdad
# lo impone es el servidor (GOOGLE_HOSTED_DOMAIN).
VITE_GOOGLE_HOSTED_DOMAIN=ampasainzvicuna.com

# La API no se configura: está siempre en /api del mismo dominio (en
# desarrollo, Vite la reenvía a Symfony; ver vite.config.ts). Tampoco la
# dirección del propio portal: es la de la página.
