# Valores por defecto. Los de este fichero son SOLO PARA DESARROLLO; en
# producción cada variable llega como variable de entorno de Cloud Run (o de
# Secret Manager, si es secreta), y una variable real manda sobre este fichero.
#
# Cargan, si existen y por este orden (el último manda): .env, .env.local,
# .env.$APP_ENV, .env.$APP_ENV.local. Los .local no se suben al repositorio.

###> symfony/framework-bundle ###
APP_ENV=dev
# En producción se deduce de JWT_KEY al arrancar, como en listados: el portal
# no usa APP_SECRET para nada (sin sesiones de PHP, sin formularios, sin URLs
# firmadas) y no merece gastar un secreto.
APP_SECRET=desarrollo-no-secreto-5e2c8a41f7b9
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8083
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# En Docker la pone docker-compose.yml (servicio "db").
DATABASE_URL="postgresql://suite:suite@db:5432/suite?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> ampa/portal ###
# Clave con la que el portal firma la sesión de la suite (HS256: una cadena,
# ver SessionTokens). HS256 exige al menos 32 bytes. En producción, un secreto
# de Secret Manager: el único de firma de toda la suite.
JWT_KEY=desarrollo-no-secreto-8c1f4e7a2b9d0536fe1a7c4b2d8e9f30

# La cookie de sesión (ver SessionCookie).
#   Dominio: en producción ".ampasainzvicuna.com", para que valga en todos los
#   subdominios. Vacío en desarrollo: la cookie es de "localhost", y en
#   localhost vale para todos los puertos (el portal y cada aplicación).
#   Secure: en producción siempre; en desarrollo no, porque va por http.
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=0

# ID de cliente OAuth de Google. No es secreto: viaja al navegador. Es el del
# proyecto de Google Cloud de la suite, el mismo que usaban fichajes y
# listados; hay que añadirle los orígenes del portal.
GOOGLE_CLIENT_ID=273203000301-6psq29vv6e3e607hpoqhhvq6be49pvgf.apps.googleusercontent.com

# Dominio de Workspace exigido a quien entra. Vacío lo desactiva, y habrá que
# vaciarlo cuando tareas admita cuentas personales: entonces la barrera son
# solo los permisos (y pasar el OAuth a "Externo").
GOOGLE_HOSTED_DOMAIN=ampasainzvicuna.com

# Las llamadas del servidor de una aplicación sin nadie detrás (el resumen
# diario de tareas, a las 5:00; cliente 0.1.3): el token de identidad de Google
# de su cuenta de servicio, emitido para esta audiencia (la dirección fija del
# portal en Cloud Run) y solo de estas cuentas (separadas por comas). En
# desarrollo, vacías: no hay servidor de metadatos que emita esos tokens, así
# que no se acepta ninguno. Las pone deploy/desplegar.sh.
SUITE_TOKEN_AUDIENCE=
SUITE_SERVICE_ACCOUNTS=

# El latido diario (POST /api/latido, RunHeartbeat). Cada paso, vacío, se salta.
#   COPIAS_JOB: el job de Cloud Run de las copias de seguridad, con su nombre
#   completo (projects/ID/locations/europe-west1/jobs/ampa-copias). Lo pone
#   deploy/desplegar.sh.
#   NEON_PROJECT_ID y NEON_API_KEY (secreto neon-api-key): para mirar cuánto
#   cómputo lleva gastado la suite este mes. NEON_COMPUTE_HOURS: lo que da el
#   plan gratuito de Neon (100 CU-horas al mes por proyecto, 26/09/2026).
COPIAS_JOB=
NEON_PROJECT_ID=
NEON_API_KEY=
NEON_COMPUTE_HOURS=100

# Dónde está cada aplicación, para las tarjetas del portal (ver
# config/packages/suite.yaml). En desarrollo, el Vite de cada una.
URL_FICHAJES=http://localhost:5173
URL_LISTADOS=http://localhost:5174
URL_FACTURACION=http://localhost:5175
URL_TAREAS=http://localhost:5177
URL_CRM=http://localhost:5178
URL_DOCUMENTOS=http://localhost:5179

# Orígenes, además de las aplicaciones de arriba y del propio portal
# (DEFAULT_URI), cuyo front puede leer GET /api/ayuda desde el navegador
# (CORS, ver HelpCors), separados por comas. En desarrollo, los Vite de la
# suite (5173-5179: fichajes, listados, facturación, portal, tareas,
# proveedores y documentos), para que funcione aunque una URL_… apunte a otro
# sitio. En producción, VACÍA (la pone así deploy/desplegar.sh): allí bastan
# las del catálogo.
HELP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178,http://localhost:5179
###< ampa/portal ###
